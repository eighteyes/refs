#!/bin/sh
# refs — launcher for the Go binary, used by the plugin hook (hooks/hooks.json).
#
# Responsibilities:
#   - build the binary into bin/.build/refs on first run
#   - rebuild when any *.go file or go.mod is newer than the binary
#   - send all build output to stderr; stdout stays clean for hook JSON
#   - exec the binary with all args
#   - without Go and without a binary: `hook` prints valid hook JSON that says
#     refs needs Go; any other command errors on stderr and exits 1
root=$(cd "$(dirname "$0")/.." && pwd -P)
bin="$root/bin/.build/refs"

stale() {
	[ ! -x "$bin" ] && return 0
	[ -n "$(find "$root" -maxdepth 1 \( -name '*.go' -o -name go.mod \) ! -name '*_test.go' -newer "$bin" 2>/dev/null)" ]
}

# nobinary MSG: hook gets valid JSON and exit 0; anything else errors.
nobinary() {
	if [ "$1" = hook ]; then
		printf '{"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": "%s"}}\n' "$2"
		exit 0
	fi
	echo "refs: $2" >&2
	exit 1
}

if stale; then
	if command -v go >/dev/null 2>&1; then
		mkdir -p "$root/bin/.build"
		tmp="$bin.$$"
		if (cd "$root" && go build -o "$tmp" .) >&2; then
			mv -f "$tmp" "$bin"
		else
			rm -f "$tmp"
			echo "refs: go build failed" >&2
			[ -x "$bin" ] || nobinary "${1:-}" "refs failed to build with Go; see stderr, or run: go install github.com/eighteyes/refs@latest"
		fi
	elif [ ! -x "$bin" ]; then
		nobinary "${1:-}" "refs needs Go to build. Install Go, or run: go install github.com/eighteyes/refs@latest"
	fi
fi

exec "$bin" "$@"
